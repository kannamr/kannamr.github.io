# Generate your own token; never commit it.
INFERENCE_API_KEY=
INFERENCE_BACKEND=synthetic
INFERENCE_MODEL=synthetic-v1
INFERENCE_MAX_CONCURRENT=2
INFERENCE_REQUESTS_PER_MINUTE=60
INFERENCE_BURST=5
INFERENCE_TIMEOUT_SECONDS=10
# Used only with INFERENCE_BACKEND=ollama and a locally installed model.
INFERENCE_BACKEND_URL=http://127.0.0.1:11434
